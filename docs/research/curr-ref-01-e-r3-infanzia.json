    },
    {
      "id": "ER3-03",
      "state": "LOCAL_DRAFT_DETAIL_NOT_IN_MASTER",
      "subject": "Finalità più estese in quattro campi; manca una finalità autonoma per I discorsi e le parole nella fonte locale, mentre la fonte nazionale la contiene. Riesame, non completamento automatico."
    },
    {
      "id": "ER3-04",
      "state": "LOCAL_ANNUALIZATION_REVIEW_REQUIRED",
      "subject": "Il limite numerico di conteggio a 5 anni è locale, non soglia nazionale di accesso alla primaria; osservazione rispettosa dei ritmi."
    },
    {
      "id": "ER3-05",
      "state": "NATIVE_NAME_RECONCILIATION",
      "subject": "Il corpo in movimento nella fonte locale storica, Il corpo e il movimento nel master e nel decreto; mantenere provenienza."
    },
