{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TRAMA Visual Art Direction Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "capabilityId",
    "specId",
    "product",
    "source",
    "safety",
    "materials",
    "lighting",
    "sky",
    "cameras",
    "render",
    "acceptance"
  ],
  "properties": {
    "schemaVersion": {
      "const": "visual.art-direction.spec/v1"
    },
    "capabilityId": {
      "const": "visual.art-direction.propose"
    },
    "specId": {
      "type": "string",
      "minLength": 8
    },
    "product": {
      "type": "string",
      "enum": [
        "ATLAS",
        "ARENA",
        "DOCENTE_OS"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactName",
        "sha256",
        "architecture",
        "immutable"
      ],
      "properties": {
        "artifactName": {
          "type": "string",
          "minLength": 4
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "architecture": {
          "type": "string",
          "minLength": 8
        },
        "immutable": {
          "const": true
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "derivativeOnly",
        "studentData",
        "publishAuthorized",
        "mergeAuthorized",
        "paidServices"
      ],
      "properties": {
        "derivativeOnly": {
          "const": true
        },
        "studentData": {
          "const": false
        },
        "publishAuthorized": {
          "const": false
        },
        "mergeAuthorized": {
          "const": false
        },
        "paidServices": {
          "const": false
        }
      }
    },
    "materials": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "selectors",
          "baseColor",
          "metallic",
          "roughness",
          "alpha",
          "transmission",
          "purpose"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 3
          },
          "selectors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "baseColor": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "metallic": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "roughness": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "alpha": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "transmission": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 8
          }
        }
      }
    },
    "lighting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "keyPower",
        "keySize",
        "fillPower",
        "fillSize",
        "warmPower",
        "warmSize"
      ],
      "properties": {
        "mode": {
          "const": "blender_area_three_point"
        },
        "keyPower": {
          "type": "number",
          "minimum": 0,
          "maximum": 5000
        },
        "keySize": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 40
        },
        "fillPower": {
          "type": "number",
          "minimum": 0,
          "maximum": 5000
        },
        "fillSize": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 40
        },
        "warmPower": {
          "type": "number",
          "minimum": 0,
          "maximum": 5000
        },
        "warmSize": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 40
        }
      }
    },
    "sky": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "sunElevationDegrees",
        "airDensity",
        "dustDensity",
        "worldStrength"
      ],
      "properties": {
        "model": {
          "const": "PHYSICAL_ATMOSPHERE"
        },
        "sunElevationDegrees": {
          "type": "number",
          "minimum": -2,
          "maximum": 90
        },
        "worldStrength": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "airDensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "dustDensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        }
      }
    },
    "cameras": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "masterName",
        "desktop",
        "phone"
      ],
      "properties": {
        "masterName": {
          "type": "string",
          "minLength": 5
        },
        "desktop": {
          "$ref": "#/$defs/frame"
        },
        "phone": {
          "$ref": "#/$defs/frame"
        }
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "samples",
        "denoise"
      ],
      "properties": {
        "engine": {
          "const": "CYCLES"
        },
        "samples": {
          "type": "integer",
          "minimum": 4,
          "maximum": 128
        },
        "denoise": {
          "type": "boolean"
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fourPortals",
        "galleryLevels",
        "oculusRadiusBU",
        "humanArtApproval"
      ],
      "properties": {
        "fourPortals": {
          "const": 4
        },
        "galleryLevels": {
          "const": 4
        },
        "oculusRadiusBU": {
          "const": 6.25
        },
        "humanArtApproval": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "lensMultiplier",
        "shiftY"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 320,
          "maximum": 4096
        },
        "height": {
          "type": "integer",
          "minimum": 240,
          "maximum": 4096
        },
        "lensMultiplier": {
          "type": "number",
          "minimum": 0.65,
          "maximum": 1.2
        },
        "shiftY": {
          "type": "number",
          "minimum": -0.25,
          "maximum": 0.25
        }
      }
    }
  }
}
