# TRAMA Penpot pilot — copy to .env and keep .env untracked.
PENPOT_VERSION=2.18
PENPOT_PUBLIC_URI=http://localhost:9001

# Generate with:
# python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PENPOT_SECRET_KEY=REPLACE_WITH_RANDOM_512_BIT_SECRET

# Use a strong unique password even for pilot environments.
PENPOT_DATABASE_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# LOCAL PILOT ONLY.
# For public HTTPS deployment, remove both disable-* flags below and perform security review.
PENPOT_FLAGS=disable-email-verification disable-secure-session-cookies enable-mcp
