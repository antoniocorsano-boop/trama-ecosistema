{
  "contract": "CC-MSS-01-CREDENTIAL-PROVIDER-v1",
  "provider": "ACTIONS_EPHEMERAL_TOKEN",
  "state": "OFFLINE_CANDIDATE",
  "live": "NOT_AUTHORIZED",
  "scope": "SAME_REPOSITORY_ONLY",
  "tokenOrigin": "GITHUB_ACTIONS_JOB_EPHEMERAL",
  "acceptedSecretInputs": [],
  "decisionPackageCredentialMaterial": false,
  "operations": ["repo.read", "ref.read", "commit.read"],
  "httpMethod": "GET",
  "evidenceDestination": "LOCAL_EPHEMERAL_ONLY",
  "requiredWorkflowPermissions": {
    "contents": "read",
    "metadata": "read"
  },
  "prohibitedTriggers": ["pull_request_target"],
  "prohibitedCapabilities": [
    "cross-repository-access",
    "token-persistence",
    "artifact-upload",
    "cache-secret-persistence",
    "remote-evidence-persistence",
    "workflow-dispatch-live-probe",
    "repository-write",
    "contents-write",
    "pull-request-write",
    "issues-write",
    "actions-write",
    "checks-write"
  ],
  "credentialLifecycle": {
    "materializeAfterAtomicClaim": true,
    "invalidateOnSuccess": true,
    "invalidateOnFailure": true,
    "reusableContext": false
  },
  "humanAuthorizationRequired": true,
  "notes": "Offline provider profile only. It neither reads nor authorizes use of github.token/GITHUB_TOKEN."
}
