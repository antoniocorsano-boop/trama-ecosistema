{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trama.local/schemas/atlas-visual-production-request.v0.1.schema.json",
  "title": "Atlas Visual Production Request v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "pathwayId",
    "packageDigest",
    "operation",
    "sceneRefs",
    "qualityProfile",
    "productForm",
    "computePolicyRef",
    "paidComputeAuthorized",
    "allowQualityDowngrade",
    "maxAttempts"
  ],
  "properties": {
    "schemaVersion": {
      "const": "atlas.visual-production-request/v0.1"
    },
    "requestId": {
      "type": "string",
      "minLength": 3
    },
    "pathwayId": {
      "type": "string",
      "minLength": 3
    },
    "packageDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "operation": {
      "type": "string",
      "enum": [
        "GENERATE",
        "EDIT",
        "VARIANT"
      ]
    },
    "sceneRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "qualityProfile": {
      "type": "string",
      "enum": [
        "Q3",
        "Q4"
      ]
    },
    "productForm": {
      "type": "string",
      "enum": [
        "illustrated-sequence",
        "motion-illustration",
        "micro-animation",
        "interactive-scene",
        "hybrid"
      ]
    },
    "artDirectionRef": {
      "type": "string"
    },
    "referenceLockRef": {
      "type": "string"
    },
    "inputAssetRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "maxVariants": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "computePolicyRef": {
      "const": "TRAMA Compute Policy v0.1"
    },
    "paidComputeAuthorized": {
      "const": false
    },
    "allowQualityDowngrade": {
      "const": false
    },
    "maxAttempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "requestedBySubjectRef": {
      "type": "string"
    },
    "requestedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
