{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trama.local/schemas/trama-compute-policy.v0.1.schema.json",
  "title": "TRAMA Compute Policy v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyId",
    "costMode",
    "qualityProfile",
    "minVramGiB",
    "minSystemRamGiB",
    "minDiskGiB",
    "acceleratorPreference",
    "maxProviderAttempts",
    "maxSnapshotAgeMinutes",
    "requiredEstimatedRunsRemaining",
    "noPaidFallback",
    "noQualityDowngrade"
  ],
  "properties": {
    "schemaVersion": {
      "const": "trama.compute-policy/v0.1"
    },
    "policyId": {
      "type": "string",
      "minLength": 3
    },
    "costMode": {
      "const": "FREE_ONLY"
    },
    "qualityProfile": {
      "type": "string",
      "minLength": 1
    },
    "minVramGiB": {
      "type": "number",
      "minimum": 1
    },
    "minSystemRamGiB": {
      "type": "number",
      "minimum": 1
    },
    "minDiskGiB": {
      "type": "number",
      "minimum": 1
    },
    "acceleratorPreference": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "maxProviderAttempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "maxSnapshotAgeMinutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1440
    },
    "requiredEstimatedRunsRemaining": {
      "type": "integer",
      "minimum": 1
    },
    "providerAllowlist": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "noPaidFallback": {
      "const": true
    },
    "noQualityDowngrade": {
      "const": true
    }
  }
}
