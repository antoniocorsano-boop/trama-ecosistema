{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://trama.local/schemas/ui-evidence.manifest.schema.json",
  "title":"TRAMA UI Evidence Manifest v1",
  "type":"object","additionalProperties":false,
  "required":["schemaVersion","contract","product","change","responsive","accessibility","perceptibleWrite","designSystem","boundaries","exceptions"],
  "properties":{
    "schemaVersion":{"const":"1.0.0"},
    "contract":{"type":"object","additionalProperties":false,"required":["id","version"],"properties":{"id":{"const":"TRAMA-UI-EVIDENCE-01"},"version":{"const":"1"}}},
    "product":{"type":"object","additionalProperties":false,"required":["id","profile","profileVersion"],"properties":{"id":{"type":"string","minLength":1},"profile":{"type":"string","minLength":1},"profileVersion":{"type":"string","minLength":1}}},
    "change":{"type":"object","additionalProperties":false,"required":["aggregateUiImpact","surfaces"],"properties":{"aggregateUiImpact":{"enum":["NONE","NEW","CHANGED","LEGACY_TOUCHED"]},"surfaces":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","uiImpact"],"properties":{"id":{"type":"string","minLength":1},"uiImpact":{"enum":["NONE","NEW","CHANGED","LEGACY_TOUCHED"]},"journeys":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true}}}}}},
    "responsive":{"type":"object","additionalProperties":false,"required":["conditions","evidence"],"properties":{"conditions":{"type":"object","additionalProperties":false,"required":["S","M","L","LIM"],"properties":{"S":{"$ref":"#/$defs/condition"},"M":{"$ref":"#/$defs/condition"},"L":{"$ref":"#/$defs/condition"},"LIM":{"$ref":"#/$defs/condition"}}},"evidence":{"type":"array","items":{"$ref":"#/$defs/responsiveEvidence"}}}},
    "accessibility":{"type":"object","additionalProperties":false,"required":["evidence","findings"],"properties":{"evidence":{"type":"array","items":{"$ref":"#/$defs/evidence"}},"findings":{"type":"array","items":{"$ref":"#/$defs/finding"}}}},
    "perceptibleWrite":{"type":"object","additionalProperties":false,"required":["classification","evidence"],"properties":{"classification":{"type":"string","minLength":1},"evidence":{"type":"array","items":{"$ref":"#/$defs/evidence"}}}},
    "designSystem":{"type":"object","additionalProperties":false,"required":["tokens","components","newComponents"],"properties":{"tokens":{"type":"array","items":{"type":"string"}},"components":{"type":"array","items":{"type":"string"}},"newComponents":{"type":"array","items":{"type":"string"}}}},
    "boundaries":{"type":"object","additionalProperties":false,"required":["authorityImpact","privacyImpact","runtimeImpact","dosA1"],"properties":{"authorityImpact":{"type":"string"},"privacyImpact":{"type":"string"},"runtimeImpact":{"const":"NONE"},"dosA1":{"const":"RUNTIME_DEFERRED"}}},
    "exceptions":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true}
  },
  "$defs":{
    "condition":{"type":"object","additionalProperties":false,"required":["applicable"],"properties":{"applicable":{"type":"boolean"},"reason":{"type":"string","minLength":1}},"allOf":[{"if":{"properties":{"applicable":{"const":false}},"required":["applicable"]},"then":{"required":["reason"]}}]},
    "evidence":{"type":"object","additionalProperties":false,"required":["evidenceId","type","result","commitSha","producer","reference"],"properties":{"evidenceId":{"type":"string","minLength":1},"type":{"type":"string","minLength":1},"result":{"enum":["PASS","FAIL","NOT_APPLICABLE"]},"commitSha":{"type":"string","pattern":"^[0-9a-f]{40}$"},"producer":{"type":"string","minLength":1},"reference":{"type":"string","minLength":1},"digest":{"type":"string","minLength":1},"immutableRunId":{"type":"string","minLength":1}},"anyOf":[{"required":["digest"]},{"required":["immutableRunId"]}]},
    "responsiveEvidence":{"type":"object","additionalProperties":false,"required":["evidenceId","type","result","commitSha","producer","reference","condition","policyId","policyVersion","width","height"],"properties":{"evidenceId":{"type":"string","minLength":1},"type":{"const":"responsive"},"result":{"enum":["PASS","FAIL","NOT_APPLICABLE"]},"commitSha":{"type":"string","pattern":"^[0-9a-f]{40}$"},"producer":{"type":"string","minLength":1},"reference":{"type":"string","minLength":1},"digest":{"type":"string","minLength":1},"immutableRunId":{"type":"string","minLength":1},"condition":{"enum":["S","M","L","LIM"]},"policyId":{"type":"string","minLength":1},"policyVersion":{"type":"string","minLength":1},"width":{"type":"integer","minimum":1},"height":{"type":"integer","minimum":1}},"anyOf":[{"required":["digest"]},{"required":["immutableRunId"]}]},
    "finding":{"type":"object","additionalProperties":false,"required":["findingId","criterion","blockingClass","status","surfaceId","evidenceRef"],"properties":{"findingId":{"type":"string","minLength":1},"criterion":{"type":"string","minLength":1},"blockingClass":{"enum":["BLOCKING","NON_BLOCKING"]},"status":{"enum":["OPEN","RESOLVED","ACCEPTED_EXCEPTION"]},"surfaceId":{"type":"string","minLength":1},"evidenceRef":{"type":"string","minLength":1},"exceptionId":{"type":"string","minLength":1}},"allOf":[{"if":{"properties":{"status":{"const":"ACCEPTED_EXCEPTION"}},"required":["status"]},"then":{"required":["exceptionId"]}}]}
  }
}
