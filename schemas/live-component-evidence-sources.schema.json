{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trama.local/schemas/live-component-evidence-sources.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sources"
  ],
  "properties": {
    "schemaVersion": {
      "const": "trama.live-component-evidence-sources/v1"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "componentId",
          "evidenceType",
          "repository",
          "defaultBranch",
          "workflowName",
          "artifactPrefix"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "componentId": {
            "type": "string",
            "minLength": 1
          },
          "evidenceType": {
            "enum": [
              "ISOLATED",
              "BEHAVIOURAL",
              "RESPONSIVE_VISUAL",
              "ACCESSIBILITY"
            ]
          },
          "repository": {
            "type": "string",
            "pattern": "^[^/]+/[^/]+$"
          },
          "defaultBranch": {
            "type": "string",
            "minLength": 1
          },
          "workflowName": {
            "type": "string",
            "minLength": 1
          },
          "artifactPrefix": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
