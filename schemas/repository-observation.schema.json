{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trama.local/schemas/repository-observation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "collectionId",
    "observedAt",
    "status",
    "repositories",
    "pullRequests",
    "sourceRefs"
  ],
  "properties": {
    "schemaVersion": {
      "const": "trama.repository-observation/v1"
    },
    "collectionId": {
      "type": "string",
      "minLength": 1
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "UNKNOWN"
      ]
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository",
          "enrollmentRef",
          "availabilityStatus",
          "freshnessStatus",
          "completenessStatus",
          "observedHead",
          "sourceRefs"
        ],
        "properties": {
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "enrollmentRef": {
            "type": "string",
            "minLength": 1
          },
          "availabilityStatus": {
            "enum": [
              "AVAILABLE",
              "UNAVAILABLE",
              "UNKNOWN"
            ]
          },
          "freshnessStatus": {
            "enum": [
              "FRESH",
              "STALE",
              "UNKNOWN"
            ]
          },
          "completenessStatus": {
            "enum": [
              "COMPLETE",
              "PARTIAL",
              "UNKNOWN"
            ]
          },
          "observedHead": {
            "type": [
              "string",
              "null"
            ]
          },
          "sourceRefs": {
            "type": "array",
            "minItems": 1
          },
          "activeDevelopmentRef": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "observedActiveDevelopmentHead": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{40}$"
          }
        },
        "dependentRequired": {
          "activeDevelopmentRef": [
            "observedActiveDevelopmentHead"
          ],
          "observedActiveDevelopmentHead": [
            "activeDevelopmentRef"
          ]
        }
      }
    },
    "pullRequests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository",
          "number",
          "state",
          "draft",
          "merged",
          "observedHead",
          "observedAt",
          "sourceRefs"
        ],
        "properties": {
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "state": {
            "enum": [
              "OPEN",
              "CLOSED"
            ]
          },
          "draft": {
            "type": "boolean"
          },
          "merged": {
            "type": "boolean"
          },
          "observedHead": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "sourceRefs": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    "sourceRefs": {
      "type": "array",
      "minItems": 1
    }
  }
}
