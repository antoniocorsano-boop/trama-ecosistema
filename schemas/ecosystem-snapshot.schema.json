{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trama.local/schemas/ecosystem-snapshot.schema.json",
  "title": "TRAMA Ecosystem Snapshot",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "generatedAt",
    "sourceState",
    "phases",
    "areas",
    "capabilities",
    "gates",
    "evidence",
    "dependencies",
    "assuranceClaims",
    "expansionCandidates",
    "integrityChecks",
    "operationalPath",
    "timelineEvents",
    "timelineCoverage"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sourceState": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "FRESH",
              "STALE",
              "PARTIAL",
              "UNVERIFIED",
              "BLOCKED"
            ]
          },
          "observedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "ref": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "gateRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "areas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "confirmedLevel",
          "candidateLevel",
          "confidence",
          "status",
          "evidenceRefs",
          "blockingGateRefs",
          "dependencies",
          "lastEvaluatedAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "ownerDomain": {
            "type": [
              "string",
              "null"
            ]
          },
          "confirmedLevel": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "candidateLevel": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "confidence": {
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ]
          },
          "status": {
            "enum": [
              "FRESH",
              "STALE",
              "PARTIAL",
              "UNVERIFIED",
              "BLOCKED"
            ]
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blockingGateRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lastEvaluatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "area",
          "type",
          "status",
          "blocking"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "area": {
            "type": "string"
          },
          "type": {
            "enum": [
              "AUTOMATED",
              "RUNTIME",
              "HUMAN",
              "DOCUMENTAL"
            ]
          },
          "status": {
            "enum": [
              "OPEN",
              "IN_PROGRESS",
              "PASS",
              "FAIL",
              "WAIVED",
              "NOT_APPLICABLE"
            ]
          },
          "blocking": {
            "type": "boolean"
          },
          "requiredEvidenceTypes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "decisionAuthority": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "area",
          "subject",
          "status",
          "observedAt",
          "confidence",
          "supports"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "DOCUMENT_CANONICAL",
              "CONTRACT_APPROVED",
              "PR_EXACT_HEAD",
              "AUTOMATED_TEST",
              "SECURITY_GATE",
              "ACCESSIBILITY_GATE",
              "RUNTIME_CANARY",
              "HUMAN_REVIEW",
              "REAL_CASE_VALIDATION",
              "PROMOTION_DECISION",
              "REGRESSION_HISTORY",
              "ADOPTION_EVIDENCE"
            ]
          },
          "area": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "PARTIAL",
              "IN_PROGRESS",
              "NOT_APPLICABLE"
            ]
          },
          "source": {
            "type": "object"
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "freshness": {
            "type": "object",
            "properties": {
              "policy": {
                "enum": [
                  "EVENT_BOUND",
                  "UNTIL_CHANGE",
                  "TIME_BOUND",
                  "RUNTIME_BOUND",
                  "MANUAL_REVIEW"
                ]
              },
              "expiresAt": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "reviewedAt": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            },
            "required": [
              "policy"
            ],
            "additionalProperties": true
          },
          "confidence": {
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ]
          },
          "supports": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "binding": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "capabilityRef": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "releaseRef": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "exactHead": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "eventRef": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "from",
          "to",
          "kind"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "AUTHORITY",
              "DEPENDENCY",
              "DATA_FLOW",
              "PUBLICATION",
              "VALIDATION",
              "FUTURE_NOT_AUTHORIZED"
            ]
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "governanceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "gateRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "expansionCandidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "status",
          "dependencyRefs"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PLANNED",
              "ELIGIBLE_FOR_DESIGN",
              "BLOCKED"
            ]
          },
          "dependencyRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "$schema": {
      "type": "string"
    },
    "assuranceClaims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "requirementId",
          "domain",
          "claimType",
          "scope",
          "status",
          "evidenceRefs",
          "reviewAuthority",
          "assessor",
          "standardRef",
          "versionRef",
          "verifiedAt",
          "expiresAt",
          "limitations",
          "externalCertificateRef",
          "targetStatus",
          "requiredEvidenceKinds",
          "presentEvidenceKinds",
          "readiness"
        ],
        "properties": {
          "requirementId": {
            "type": "string"
          },
          "domain": {
            "enum": [
              "PRIVACY",
              "NORMATIVE_GOVERNANCE",
              "ACCESSIBILITY",
              "USABILITY",
              "SECURITY",
              "OPERATIONAL_RELIABILITY",
              "EXTERNAL_CERTIFICATION"
            ]
          },
          "claimType": {
            "enum": [
              "EVIDENCE_BACKED_CLAIM",
              "INDEPENDENT_ASSESSMENT",
              "FORMAL_CERTIFICATION"
            ]
          },
          "scope": {
            "type": "string"
          },
          "status": {
            "enum": [
              "DOCUMENTED",
              "IMPLEMENTED",
              "VERIFIED",
              "THIRD_PARTY_VERIFIED",
              "FORMALLY_CERTIFIED",
              "PARTIAL",
              "TO_VERIFY",
              "NOT_APPLICABLE",
              "BLOCKED"
            ]
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reviewAuthority": {
            "type": [
              "string",
              "null"
            ]
          },
          "assessor": {
            "type": [
              "string",
              "null"
            ]
          },
          "standardRef": {
            "type": [
              "string",
              "null"
            ]
          },
          "versionRef": {
            "type": [
              "string",
              "null"
            ]
          },
          "verifiedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "expiresAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "externalCertificateRef": {
            "type": [
              "string",
              "null"
            ]
          },
          "targetStatus": {
            "enum": [
              "DOCUMENTED",
              "IMPLEMENTED",
              "VERIFIED",
              "THIRD_PARTY_VERIFIED",
              "FORMALLY_CERTIFIED"
            ]
          },
          "requiredEvidenceKinds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "CANONICAL_DOCUMENTATION",
                "VERSION_BOUND_TEST",
                "HUMAN_REVIEW",
                "INSTITUTIONAL_REVIEW",
                "INDEPENDENT_ASSESSMENT",
                "EXTERNAL_CERTIFICATE",
                "RUNTIME_EVIDENCE",
                "ACCESSIBILITY_AUDIT",
                "SECURITY_ASSESSMENT",
                "PRIVACY_REVIEW"
              ]
            }
          },
          "presentEvidenceKinds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "CANONICAL_DOCUMENTATION",
                "VERSION_BOUND_TEST",
                "HUMAN_REVIEW",
                "INSTITUTIONAL_REVIEW",
                "INDEPENDENT_ASSESSMENT",
                "EXTERNAL_CERTIFICATE",
                "RUNTIME_EVIDENCE",
                "ACCESSIBILITY_AUDIT",
                "SECURITY_ASSESSMENT",
                "PRIVACY_REVIEW"
              ]
            }
          },
          "readiness": {
            "type": "object",
            "required": [
              "currentStatus",
              "targetStatus",
              "metEvidenceKinds",
              "missingEvidenceKinds",
              "metPrerequisites",
              "requiredPrerequisites"
            ],
            "properties": {
              "currentStatus": {
                "type": "string"
              },
              "targetStatus": {
                "type": "string"
              },
              "metEvidenceKinds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "missingEvidenceKinds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "metPrerequisites": {
                "type": "integer",
                "minimum": 0
              },
              "requiredPrerequisites": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "ownerDomain",
          "state",
          "humanReview",
          "runtimeState",
          "maturityAreaRef",
          "dependencyRefs",
          "gateRefs",
          "evidenceRefs",
          "lastSignificantChange",
          "sourceRef",
          "sourceUpdatedAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "ownerDomain": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "humanReview": {
            "type": [
              "string",
              "null"
            ]
          },
          "runtimeState": {
            "type": [
              "string",
              "null"
            ]
          },
          "maturityAreaRef": {
            "type": [
              "string",
              "null"
            ]
          },
          "dependencyRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "gateRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lastSignificantChange": {
            "type": [
              "string",
              "null"
            ]
          },
          "sourceRef": {
            "type": "string"
          },
          "sourceUpdatedAt": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "integrityChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "status",
          "severity",
          "summary",
          "affectedRefs",
          "details"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "SOURCE_AVAILABILITY",
              "REFERENCE_RESOLUTION",
              "EVIDENCE_FRESHNESS",
              "GATE_EVIDENCE_BINDING",
              "RUNTIME_AUTHORIZATION",
              "CAPABILITY_EVIDENCE_ALIGNMENT"
            ]
          },
          "status": {
            "enum": [
              "PASS",
              "ISSUE",
              "NOT_EVALUABLE"
            ]
          },
          "severity": {
            "enum": [
              "INFO",
              "WARNING",
              "ERROR"
            ]
          },
          "summary": {
            "type": "string"
          },
          "affectedRefs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "details": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "operationalPath": {
      "type": "object",
      "required": [
        "currentActivities",
        "nextGates",
        "nextIncrements",
        "explicitDefers",
        "unmetDependencies"
      ],
      "additionalProperties": false,
      "properties": {
        "currentActivities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ref",
              "kind",
              "label",
              "status"
            ],
            "additionalProperties": false,
            "properties": {
              "ref": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "PHASE",
                  "CAPABILITY"
                ]
              },
              "label": {
                "type": "string"
              },
              "status": {
                "type": "string"
              }
            }
          }
        },
        "nextGates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ref",
              "area",
              "status",
              "blocking",
              "decisionAuthority"
            ],
            "additionalProperties": false,
            "properties": {
              "ref": {
                "type": "string"
              },
              "area": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "blocking": {
                "type": "boolean"
              },
              "decisionAuthority": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "nextIncrements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ref",
              "label",
              "status",
              "dependencyRefs"
            ],
            "additionalProperties": false,
            "properties": {
              "ref": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "dependencyRefs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "explicitDefers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ref",
              "label",
              "state",
              "runtimeState"
            ],
            "additionalProperties": false,
            "properties": {
              "ref": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "state": {
                "type": "string"
              },
              "runtimeState": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "unmetDependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "subjectRef",
              "dependencyRef",
              "dependencyKind",
              "dependencyStatus"
            ],
            "additionalProperties": false,
            "properties": {
              "subjectRef": {
                "type": "string"
              },
              "dependencyRef": {
                "type": "string"
              },
              "dependencyKind": {
                "enum": [
                  "GATE",
                  "CAPABILITY",
                  "DEPENDENCY",
                  "UNKNOWN"
                ]
              },
              "dependencyStatus": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "timelineEvents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "eventType",
          "occurredAt",
          "label",
          "subjectRef",
          "sourceRef",
          "authority",
          "versionRef",
          "details"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "eventType": {
            "enum": [
              "HUMAN_REVIEW",
              "MERGE",
              "ADR_APPROVAL",
              "GATE_PASS",
              "CAPABILITY_PROMOTION",
              "RUNTIME_AUTHORIZATION",
              "DEPRECATION",
              "SUPERSESSION"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "label": {
            "type": "string"
          },
          "subjectRef": {
            "type": "string"
          },
          "sourceRef": {
            "type": "string"
          },
          "authority": {
            "type": "string"
          },
          "versionRef": {
            "type": [
              "string",
              "null"
            ]
          },
          "details": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "timelineCoverage": {
      "type": "object",
      "required": [
        "mode",
        "from",
        "note",
        "sourceRef"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "PARTIAL_EXPLICIT"
          ]
        },
        "from": {
          "type": "string",
          "format": "date"
        },
        "note": {
          "type": "string"
        },
        "sourceRef": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": false
}
