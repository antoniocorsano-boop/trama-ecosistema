{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trama.local/schemas/ecosystem-snapshot.schema.json",
  "title": "TRAMA Ecosystem Snapshot",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "generatedAt",
    "sourceState",
    "phases",
    "areas",
    "gates",
    "evidence",
    "dependencies",
    "expansionCandidates"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sourceState": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "FRESH",
              "STALE",
              "PARTIAL",
              "UNVERIFIED",
              "BLOCKED"
            ]
          },
          "observedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "ref": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "gateRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "areas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "confirmedLevel",
          "candidateLevel",
          "confidence",
          "status",
          "evidenceRefs",
          "blockingGateRefs",
          "dependencies",
          "lastEvaluatedAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "ownerDomain": {
            "type": [
              "string",
              "null"
            ]
          },
          "confirmedLevel": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "candidateLevel": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "confidence": {
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ]
          },
          "status": {
            "enum": [
              "FRESH",
              "STALE",
              "PARTIAL",
              "UNVERIFIED",
              "BLOCKED"
            ]
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blockingGateRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lastEvaluatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "area",
          "type",
          "status",
          "blocking"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "area": {
            "type": "string"
          },
          "type": {
            "enum": [
              "AUTOMATED",
              "RUNTIME",
              "HUMAN",
              "DOCUMENTAL"
            ]
          },
          "status": {
            "enum": [
              "OPEN",
              "IN_PROGRESS",
              "PASS",
              "FAIL",
              "WAIVED",
              "NOT_APPLICABLE"
            ]
          },
          "blocking": {
            "type": "boolean"
          },
          "requiredEvidenceTypes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "decisionAuthority": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "area",
          "subject",
          "status",
          "observedAt",
          "confidence",
          "supports"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "DOCUMENT_CANONICAL",
              "CONTRACT_APPROVED",
              "PR_EXACT_HEAD",
              "AUTOMATED_TEST",
              "SECURITY_GATE",
              "ACCESSIBILITY_GATE",
              "RUNTIME_CANARY",
              "HUMAN_REVIEW",
              "REAL_CASE_VALIDATION",
              "PROMOTION_DECISION",
              "REGRESSION_HISTORY",
              "ADOPTION_EVIDENCE"
            ]
          },
          "area": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "PARTIAL",
              "IN_PROGRESS",
              "NOT_APPLICABLE"
            ]
          },
          "source": {
            "type": "object"
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "freshness": {
            "type": "object",
            "properties": {
              "policy": {
                "enum": [
                  "EVENT_BOUND",
                  "UNTIL_CHANGE",
                  "TIME_BOUND",
                  "RUNTIME_BOUND",
                  "MANUAL_REVIEW"
                ]
              },
              "expiresAt": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            },
            "required": [
              "policy"
            ],
            "additionalProperties": true
          },
          "confidence": {
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ]
          },
          "supports": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "kind"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "AUTHORITY",
              "DEPENDENCY",
              "DATA_FLOW",
              "PUBLICATION",
              "VALIDATION",
              "FUTURE_NOT_AUTHORIZED"
            ]
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "expansionCandidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "status",
          "dependencyRefs"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PLANNED",
              "ELIGIBLE_FOR_DESIGN",
              "BLOCKED"
            ]
          },
          "dependencyRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
