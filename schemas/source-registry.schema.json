{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trama.local/schemas/source-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required":["registryVersion","updatedAt","sources"],
  "properties":{
    "registryVersion":{"type":"string","minLength":1},
    "updatedAt":{"type":"string","format":"date"},
    "sources":{
      "type":"array",
      "items":{
        "type":"object",
        "additionalProperties":false,
        "required":["domain","authority","content","drivePolicy"],
        "properties":{
          "domain":{"type":"string","minLength":1},
          "authority":{"type":"string","minLength":1},
          "content":{"type":"array","minItems":1,"items":{"type":"string","minLength":1},"uniqueItems":true},
          "drivePolicy":{"type":"string","minLength":1},
          "anchors":{
            "type":"array",
            "items":{
              "type":"object",
              "additionalProperties":false,
              "required":["path","role","freshness"],
              "properties":{
                "path":{"type":"string","minLength":1},
                "role":{"enum":["SEMANTIC_AUTHORITY","SEMANTIC_STATUS","SEMANTIC_CONTRACT"]},
                "freshness":{"enum":["ON_CHANGE","PER_QUERY","SESSION"]}
              }
            }
          }
        }
      }
    }
  }
}
