{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trama.local/schemas/atlas-knowledge-candidate.v0.2.schema.json",
  "title": "Atlas knowledge candidate — versioned record-only pilot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runtimeAuthorized",
    "publicationAuthorized",
    "source",
    "concepts",
    "relations",
    "resources",
    "migration",
    "alignmentEvidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": "atlas.knowledge-candidate/v0.2"
    },
    "runtimeAuthorized": {
      "const": false
    },
    "publicationAuthorized": {
      "const": false
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "revision",
        "blob",
        "evidence"
      ],
      "properties": {
        "kind": {
          "const": "ATLAS_EXISTING_FIXTURE"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "blob": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "evidence": {
          "const": "RECORD_ONLY"
        }
      }
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "aliases",
          "questions",
          "definition",
          "relatedTerms"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "relatedTerms": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          }
        }
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "kind",
          "status"
        ],
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]+$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]+$"
          },
          "kind": {
            "enum": [
              "prerequisite_of",
              "related_to",
              "broader_than"
            ]
          },
          "status": {
            "const": "PROPOSED"
          }
        }
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "kind",
          "conceptIds",
          "disciplineIds",
          "schoolStages",
          "mappings",
          "sourceStatus",
          "rights",
          "accessibility"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "Scheda",
              "Presentazione",
              "Infografica",
              "Video",
              "Link",
              "Documento"
            ]
          },
          "conceptIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]+$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "disciplineIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]+$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "schoolStages": {
            "type": "array",
            "items": {
              "enum": [
                "Primaria",
                "Secondaria di primo grado"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "mappings": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "objectiveId",
                    "status",
                    "sourceVersion"
                  ],
                  "properties": {
                    "objectiveId": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]+$"
                    },
                    "status": {
                      "const": "HISTORICAL_UNRESOLVED"
                    },
                    "sourceVersion": {
                      "type": "null"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "objectiveId",
                    "status",
                    "sourceVersion",
                    "fingerprint",
                    "bandId",
                    "ordinal",
                    "text",
                    "reason",
                    "review"
                  ],
                  "properties": {
                    "objectiveId": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]+$"
                    },
                    "status": {
                      "const": "PROPOSED"
                    },
                    "sourceVersion": {
                      "type": "string",
                      "minLength": 1
                    },
                    "fingerprint": {
                      "type": "string",
                      "minLength": 1
                    },
                    "bandId": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]+$"
                    },
                    "ordinal": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    },
                    "review": {
                      "const": "PENDING"
                    }
                  }
                }
              ]
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "sourceStatus": {
            "const": "RECORD_ONLY"
          },
          "rights": {
            "const": "UNRESOLVED"
          },
          "accessibility": {
            "const": "UNVERIFIED"
          }
        }
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fromVersion",
        "fromBlob",
        "state"
      ],
      "properties": {
        "fromVersion": {
          "const": "atlas.knowledge-candidate/v0.1"
        },
        "fromBlob": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "state": {
          "const": "NON_DESTRUCTIVE_CANDIDATE"
        }
      }
    },
    "alignmentEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "authorityState",
        "masterVersion",
        "fingerprint",
        "sourceBlob",
        "arenaRevision",
        "atlasRevision",
        "projectionBlob",
        "projectionState",
        "bands"
      ],
      "properties": {
        "authority": {
          "const": "Arena"
        },
        "authorityState": {
          "const": "PROVISIONAL_COMPLETE"
        },
        "masterVersion": {
          "type": "string",
          "minLength": 1
        },
        "fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "sourceBlob": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "arenaRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "atlasRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "projectionBlob": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "projectionState": {
          "const": "CANDIDATE_NOT_MERGED"
        },
        "bands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "disciplineId",
              "schoolStage",
              "gradeLabel",
              "regime",
              "sourceSection",
              "objectives"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]+$"
              },
              "disciplineId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]+$"
              },
              "schoolStage": {
                "enum": [
                  "Primaria",
                  "Secondaria di primo grado"
                ]
              },
              "gradeLabel": {
                "type": "string",
                "minLength": 1
              },
              "regime": {
                "type": "string",
                "minLength": 1
              },
              "sourceSection": {
                "type": "string",
                "minLength": 1
              },
              "objectives": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "ordinal",
                    "text"
                  ],
                  "properties": {
                    "ordinal": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "minItems": 1,
                "uniqueItems": true
              }
            }
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  }
}
