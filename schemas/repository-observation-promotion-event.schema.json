{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trama.local/schemas/repository-observation-promotion-event.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "proposalId",
    "observationDigest",
    "previousObservationDigest",
    "recordedAt",
    "recordedBy",
    "sourceRunId",
    "sourceReceiptRef",
    "collectorExactSha",
    "promotionActorExactSha",
    "promotionPolicyDigest",
    "repositoryEnrollmentDigest",
    "result",
    "sourceRefs",
    "supersedes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "trama.repository-observation-promotion-event/v1"
    },
    "eventId": {
      "type": "string",
      "pattern": "^rope-[0-9a-f]{64}$"
    },
    "proposalId": {
      "type": "string",
      "pattern": "^rop-[0-9a-f]{64}$"
    },
    "observationDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "previousObservationDigest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "recordedBy": {
      "type": "string",
      "minLength": 1
    },
    "sourceRunId": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "sourceReceiptRef": {
      "type": "string",
      "minLength": 1
    },
    "collectorExactSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "promotionActorExactSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "promotionPolicyDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repositoryEnrollmentDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "result": {
      "const": "PROMOTED"
    },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^rope-[0-9a-f]{64}$"
      }
    }
  }
}
