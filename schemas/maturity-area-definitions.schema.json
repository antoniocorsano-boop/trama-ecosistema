{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trama.local/schemas/maturity-area-definitions.schema.json",
  "title": "TRAMA Maturity Area Definitions",
  "type": "object",
  "required": [
    "schemaVersion",
    "areas"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "areas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "ownerDomain",
          "dependencies",
          "levels"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "ownerDomain": {
            "type": "string",
            "minLength": 1
          },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "levels": {
            "type": "object",
            "required": [
              "0",
              "1",
              "2",
              "3",
              "4",
              "5"
            ],
            "additionalProperties": false,
            "patternProperties": {
              "^[0-5]$": {
                "type": "object",
                "required": [
                  "requiredEvidenceTypes",
                  "description"
                ],
                "properties": {
                  "requiredEvidenceTypes": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string"
                    }
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
