{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trama.local/schemas/atlas-visual-shot-plan.v0.1.schema.json",
  "title": "Atlas Visual Shot Plan v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "pathwayId",
    "visualBibleRef",
    "shots",
    "runtimeAuthorized"
  ],
  "properties": {
    "schemaVersion": {
      "const": "atlas.visual-shot-plan/v0.1"
    },
    "pathwayId": {
      "type": "string",
      "minLength": 3
    },
    "visualBibleRef": {
      "type": "string",
      "minLength": 1
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "shotId",
          "sceneRef",
          "generationClass",
          "narrativeBeat",
          "environmentRef",
          "characterRefs",
          "camera",
          "promptCore",
          "negativeConstraints",
          "aspectRatio",
          "referenceRequired"
        ],
        "properties": {
          "shotId": {
            "type": "string",
            "minLength": 1
          },
          "sceneRef": {
            "type": "string",
            "minLength": 1
          },
          "generationClass": {
            "enum": [
              "DRAFT",
              "PRODUCTION"
            ]
          },
          "narrativeBeat": {
            "type": "string",
            "minLength": 1
          },
          "environmentRef": {
            "type": "string",
            "minLength": 1
          },
          "characterRefs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "camera": {
            "type": "string",
            "minLength": 1
          },
          "poseControlRef": {
            "type": "string"
          },
          "compositionControlRef": {
            "type": "string"
          },
          "continuityRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "promptCore": {
            "type": "string",
            "minLength": 1
          },
          "negativeConstraints": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "aspectRatio": {
            "type": "string",
            "pattern": "^[0-9]+:[0-9]+$"
          },
          "referenceRequired": {
            "type": "boolean"
          }
        }
      }
    },
    "runtimeAuthorized": {
      "const": false
    }
  }
}
