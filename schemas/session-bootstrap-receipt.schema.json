{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trama.local/schemas/session-bootstrap-receipt.schema.json",
  "title": "TRAMA Session Bootstrap Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bootstrapStatus",
    "subjectResolution",
    "governedContext",
    "liveVerification",
    "sourceRefs",
    "authority"
  ],
  "properties": {
    "schemaVersion": {"const": "trama.session-bootstrap-receipt/v1"},
    "bootstrapStatus": {
      "enum": ["READY", "READY_LIVE_CHECK_REQUIRED", "PARTIAL_CONTEXT", "BLOCKED"]
    },
    "subjectResolution": {
      "type": "object",
      "required": ["status", "query", "matchedRules", "contextSubjects"],
      "properties": {
        "status": {"enum": ["RESOLVED", "PARTIAL"]},
        "query": {"type": "string", "minLength": 1},
        "explicitSubject": {"type": ["string", "null"]},
        "matchedRules": {"type": "array"},
        "contextSubjects": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "governedContext": {
      "type": "object",
      "required": [
        "snapshotRef",
        "snapshotGeneratedAt",
        "snapshotStatus",
        "governedDocuments",
        "facts",
        "decisions",
        "activeInvariants",
        "evidence",
        "exactHeads",
        "blockingGates",
        "dependencies",
        "knownConflicts",
        "knownRejectedApproaches",
        "nextCandidateActions",
        "applicableLessons",
        "lessonRecurrence",
        "negativeKnowledgeChecked"
      ],
      "properties": {
        "snapshotRef": {"type": "string"},
        "snapshotGeneratedAt": {"type": "string"},
        "snapshotStatus": {"enum": ["CURRENT", "PARTIAL"]},
        "governedDocuments": {"type": "array"},
        "facts": {"type": "array"},
        "decisions": {"type": "array"},
        "activeInvariants": {"type": "array"},
        "evidence": {"type": "array"},
        "exactHeads": {"type": "array"},
        "blockingGates": {"type": "array"},
        "dependencies": {"type": "array"},
        "knownConflicts": {"type": "array"},
        "knownRejectedApproaches": {"type": "array"},
        "nextCandidateActions": {"type": "array"},
        "applicableLessons": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "lessonId",
              "title",
              "status",
              "active",
              "subjects",
              "fingerprint",
              "sourceRepository",
              "sourceRefs",
              "canonicalDocument",
              "supersedes"
            ],
            "properties": {
              "lessonId": {"type": "string", "minLength": 1},
              "title": {"type": "string", "minLength": 1},
              "status": {"const": "CURRENT"},
              "active": {"const": true},
              "category": {"type": ["string", "null"]},
              "scope": {"type": ["string", "null"]},
              "priority": {"type": ["string", "null"]},
              "subjects": {
                "type": "array",
                "items": {"type": "string", "minLength": 1},
                "uniqueItems": true
              },
              "fingerprint": {"type": ["string", "null"]},
              "causalStatus": {"type": ["string", "null"]},
              "sourceRepository": {"type": "string", "minLength": 1},
              "sourceRefs": {"type": "array", "minItems": 1},
              "canonicalDocument": {"type": "string", "minLength": 1},
              "supersedes": {
                "type": "array",
                "items": {"type": "string", "minLength": 1},
                "uniqueItems": true
              },
              "humanDecisionRef": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          }
        },
        "lessonRecurrence": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": {"enum": ["NONE", "POSSIBLE_RECURRENCE"]},
            "lessonId": {"type": "string", "minLength": 1},
            "reason": {"const": "FINGERPRINT_MATCH"}
          },
          "allOf": [
            {
              "if": {"properties": {"status": {"const": "POSSIBLE_RECURRENCE"}}},
              "then": {"required": ["lessonId", "reason"]}
            }
          ],
          "additionalProperties": false
        },
        "negativeKnowledgeChecked": {"const": true}
      },
      "additionalProperties": false
    },
    "liveVerification": {
      "type": "object",
      "required": [
        "provided",
        "required",
        "reason",
        "effectiveContextStatus",
        "liveObservationStatus",
        "semanticDriftStatus"
      ],
      "properties": {
        "provided": {"type": "boolean"},
        "required": {"type": "boolean"},
        "reason": {"type": "string"},
        "effectiveContextStatus": {
          "type": ["string", "null"],
          "enum": ["USABLE", "DEGRADED", "BLOCKED", null]
        },
        "liveObservationStatus": {
          "type": ["string", "null"],
          "enum": ["FRESH", "STALE", "PARTIAL", "UNAVAILABLE", null]
        },
        "semanticDriftStatus": {
          "type": ["string", "null"],
          "enum": ["NONE", "DETECTED", "REVIEW_REQUIRED", null]
        },
        "liveObservedAt": {"type": "string"}
      },
      "additionalProperties": false
    },
    "sourceRefs": {"type": "array", "minItems": 1},
    "authority": {
      "type": "object",
      "required": [
        "readOnly",
        "createsAuthority",
        "authorizesWrite",
        "authorizesRuntime",
        "authorizesPromotion"
      ],
      "properties": {
        "readOnly": {"const": true},
        "createsAuthority": {"const": false},
        "authorizesWrite": {"const": false},
        "authorizesRuntime": {"const": false},
        "authorizesPromotion": {"const": false}
      },
      "additionalProperties": false
    }
  }
}
