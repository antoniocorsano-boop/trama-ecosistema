{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trama.local/schemas/trama-context-pack.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "subject",
    "asOf",
    "status",
    "facts",
    "decisions",
    "activeInvariants",
    "evidence",
    "exactHeads",
    "blockingGates",
    "dependencies",
    "knownConflicts",
    "knownRejectedApproaches",
    "nextCandidateActions",
    "sourceRefs"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "asOf": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "CURRENT",
        "PARTIAL"
      ]
    },
    "facts": {
      "type": "array"
    },
    "decisions": {
      "type": "array"
    },
    "activeInvariants": {
      "type": "array"
    },
    "evidence": {
      "type": "array"
    },
    "exactHeads": {
      "type": "array"
    },
    "blockingGates": {
      "type": "array"
    },
    "dependencies": {
      "type": "array"
    },
    "knownConflicts": {
      "type": "array"
    },
    "knownRejectedApproaches": {
      "type": "array"
    },
    "nextCandidateActions": {
      "type": "array"
    },
    "sourceRefs": {
      "type": "array"
    },
    "effectiveContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "governedAsOf",
        "liveObservedAt",
        "governedKnowledgeStatus",
        "liveObservationStatus",
        "semanticDriftStatus",
        "effectiveContextStatus",
        "promotionRequired",
        "liveFacts",
        "sourceRefs"
      ],
      "properties": {
        "governedAsOf": {"type": "string", "format": "date-time"},
        "liveObservedAt": {"type": ["string", "null"], "format": "date-time"},
        "governedKnowledgeStatus": {"enum": ["CURRENT", "SUPERSEDED", "UNKNOWN"]},
        "liveObservationStatus": {"enum": ["FRESH", "STALE", "UNAVAILABLE", "PARTIAL"]},
        "semanticDriftStatus": {"enum": ["NONE", "DETECTED", "REVIEW_REQUIRED"]},
        "effectiveContextStatus": {"enum": ["USABLE", "DEGRADED", "BLOCKED"]},
        "promotionRequired": {"type": "boolean"},
        "liveFacts": {"type": "array"},
        "sourceRefs": {"type": "array"}
      }
    }
  }
}
